{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["node", "bun", "@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    ".astro/types.d.ts",
    "src",
    "scripts",
    "tests",
    "e2e",
    "playwright.config.ts",
    "emdash-env.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
