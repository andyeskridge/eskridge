---
import { getComments } from "emdash";
import { env } from "cloudflare:workers";
import { formatDate, siteEnvironment } from "../lib/site";
interface Props {
  contentId: string;
}
const { contentId } = Astro.props;
const { items: comments, total } = await getComments({
  collection: "posts",
  contentId,
  threaded: true,
  sort: "oldest",
});
const siteKey = (env as unknown as Record<string, string>).TURNSTILE_SITE_KEY;
const enabled = siteEnvironment() === "development" || !!siteKey;
// Comment status changes must be reflected immediately; do not cache this page.
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<section class="comments" aria-labelledby="discussion-title">
  <h2 id="discussion-title">A little conversation.</h2>
  <p class="comment-form-note" style="margin-top:12px">
    {total
      ? `${total} approved ${total === 1 ? "comment" : "comments"}.`
      : "No comments yet."}{" "}
    Thoughtful questions and different perspectives are welcome.
  </p>
  <ol class="comment-list">
    {comments.map((comment) => (
      <li class="comment" id={`comment-${comment.id}`}>
        <div class="comment-meta">
          <strong>{comment.authorName}</strong>
          <time datetime={comment.createdAt}>
            {formatDate(comment.createdAt)}
          </time>
        </div>
        <p class="comment-body">{comment.body}</p>
        {enabled && (
          <button
            type="button"
            class="reply-button"
            data-reply-id={comment.id}
            data-reply-name={comment.authorName}
          >
            Reply to {comment.authorName}
          </button>
        )}
        {comment.replies?.length && (
          <ol class="comment-replies">
            {comment.replies.map((reply) => (
              <li class="comment" id={`comment-${reply.id}`}>
                <div class="comment-meta">
                  <strong>{reply.authorName}</strong>
                  <time datetime={reply.createdAt}>
                    {formatDate(reply.createdAt)}
                  </time>
                </div>
                <p class="comment-body">{reply.body}</p>
                {enabled && (
                  <button
                    type="button"
                    class="reply-button"
                    data-reply-id={comment.id}
                    data-reply-name={reply.authorName}
                  >
                    Reply to {reply.authorName}
                  </button>
                )}
              </li>
            ))}
          </ol>
        )}
      </li>
    ))}
  </ol>
  {enabled ? (
    <form
      class="comment-form"
      id="comment-form"
      data-endpoint={`/_emdash/api/comments/posts/${encodeURIComponent(contentId)}`}
    >
      <p class="comment-form-note" id="comment-privacy">
        All comments are reviewed before appearing. Your email stays private and
        is only used to manage your comment.{" "}
        <a class="text-link" href="/privacy">
          Privacy details
        </a>
      </p>
      <div class="reply-context" hidden>
        <span data-reply-label></span>
        <button class="reply-button" type="button" data-cancel-reply>
          Cancel reply
        </button>
      </div>
      <div class="form-row">
        <label class="field">
          Display name
          <input
            name="authorName"
            required
            maxlength="100"
            autocomplete="nickname"
          />
        </label>
        <label class="field">
          Email (kept private)
          <input
            name="authorEmail"
            type="email"
            required
            autocomplete="email"
            aria-describedby="comment-privacy"
          />
        </label>
      </div>
      <div class="honeypot" aria-hidden="true">
        <label>
          Leave this empty
          <input
            name="website_url"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </label>
      </div>
      <label class="field">
        Your comment
        <textarea name="body" required maxlength="5000" rows="5"></textarea>
      </label>
      <input type="hidden" name="parentId" value="" />
      {siteKey && (
        <div
          class="cf-turnstile"
          data-sitekey={siteKey}
          data-action="comment"
          data-theme="auto"
        ></div>
      )}
      <button class="button" type="submit">
        Submit for review <span aria-hidden="true">→</span>
      </button>
      <p class="comment-status" role="status" aria-live="polite"></p>
      <noscript>
        <p>Enable JavaScript to submit a comment.</p>
      </noscript>
    </form>
  ) : (
    <p class="comment-form-note">
      New comments are temporarily unavailable. Please check back soon.
    </p>
  )}
</section>
{enabled && siteKey && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
)}
<script>
  const form = document.querySelector<HTMLFormElement>("#comment-form");
  const parent = form?.querySelector<HTMLInputElement>("[name=parentId]");
  const context = form?.querySelector<HTMLElement>(".reply-context");
  const replyLabel = form?.querySelector<HTMLElement>("[data-reply-label]");
  document
    .querySelectorAll<HTMLButtonElement>("[data-reply-id]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        if (parent && context && replyLabel) {
          parent.value = button.dataset.replyId || "";
          context.hidden = false;
          replyLabel.textContent = `Replying to ${button.dataset.replyName}`;
          form?.querySelector<HTMLTextAreaElement>("textarea")?.focus();
        }
      }),
    );
  form?.querySelector("[data-cancel-reply]")?.addEventListener("click", () => {
    if (parent && context) {
      parent.value = "";
      context.hidden = true;
    }
  });
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("[type=submit]");
    const status = form.querySelector<HTMLElement>(".comment-status");
    if (!button || !status || !form.dataset.endpoint) return;
    button.disabled = true;
    status.textContent = "Submitting…";
    const data = new FormData(form);
    const payload = {
      authorName: String(data.get("authorName") || ""),
      authorEmail: String(data.get("authorEmail") || ""),
      body: String(data.get("body") || ""),
      website_url: String(data.get("website_url") || ""),
      ...(data.get("parentId")
        ? { parentId: String(data.get("parentId")) }
        : {}),
      ...(data.get("cf-turnstile-response")
        ? { turnstileToken: String(data.get("cf-turnstile-response")) }
        : {}),
    };
    try {
      const response = await fetch(form.dataset.endpoint, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-EmDash-Request": "1",
        },
        body: JSON.stringify(payload),
      });
      const result = (await response.json()) as {
        error?: { message?: string };
      };
      if (response.ok) {
        status.textContent =
          "Thank you. Your comment is waiting for review and will appear once approved.";
        const body = form.querySelector<HTMLTextAreaElement>("textarea");
        if (body) body.value = "";
        if (parent && context) {
          parent.value = "";
          context.hidden = true;
        }
      } else {
        status.textContent =
          response.status === 429
            ? "You’ve submitted several comments. Please wait ten minutes before trying again."
            : result.error?.message ||
              "Your comment could not be submitted. Please try again.";
      }
    } catch {
      status.textContent =
        "The connection was interrupted. Your comment is still here; please try again.";
    } finally {
      const turnstile = (
        window as unknown as { turnstile?: { reset: () => void } }
      ).turnstile;
      turnstile?.reset();
      button.disabled = false;
    }
  });
</script>
