---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import EmptyState from "../components/EmptyState.astro";
import { registerHints } from "../lib/site";
const [homeResult, postsResult] = await Promise.all([
  getEmDashEntry("pages", "home", {
    references: { featured_projects: { limit: 2 } },
  }),
  getEmDashCollection("posts", {
    status: "published",
    orderBy: { published_at: "desc" },
    limit: 3,
  }),
]);
registerHints(Astro, homeResult, postsResult);
const home = homeResult.entry;
const featured = home?.references?.featured_projects.entries ?? [];
const projectsResult = featured.length
  ? null
  : await getEmDashCollection("projects", {
      status: "published",
      orderBy: { published_at: "desc" },
      limit: 2,
    });
if (projectsResult) registerHints(Astro, projectsResult);
const projects = featured.length ? featured : (projectsResult?.entries ?? []);
const heading =
  home?.data.title || "Software leadership.\nPractical curiosity.";
const intro =
  home?.data.intro ||
  "I’m Andy Eskridge, Director of Software Development at ISN in Dallas, TX. A place for ideas about leading teams, building useful things, and life beyond the screen.";
---

<Base
  noindex={homeResult.isPreview}
  description={intro}
  content={
    home ? { collection: "pages", id: home.data.id, slug: "home" } : undefined
  }
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">A personal corner of the internet</p>
      <h1 {...home?.edit.title}>{heading}</h1>
      <p class="hero-intro" {...home?.edit.intro}>
        {intro}
      </p>
      <div class="hero-links">
        <a class="text-link" href="/about">
          A little about me <Icon />
        </a>
        <a href="/writing">Explore the writing</a>
      </div>
    </div>
    <div class="hero-seal" aria-hidden="true">
      <div class="seal-disc">
        <span>ae.</span>
      </div>
      <span class="seal-caption">Always a work in progress</span>
    </div>
  </section>
  <div class="intro-line">
    <span>{home?.data.role || "Director of Software Development at ISN"}</span>
    <span>
      {home?.data.location || "Dallas, TX"} · Thinking, building, learning.
    </span>
  </div>
  <section class="section" aria-labelledby="selected-work">
    <div class="section-heading">
      <div>
        <h2 id="selected-work">Selected work</h2>
        <p class="section-caption">From the day job to the workbench.</p>
      </div>
      <a class="text-link" href="/projects">
        All projects <Icon />
      </a>
    </div>
    {projects.length ? (
      <div class="project-grid">
        {projects.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>
    ) : (
      <EmptyState
        title="Good things take a little work."
        text="Project stories are on their way. This space is for real work, useful experiments, and the lessons along the way."
      />
    )}
  </section>
  <section class="section" aria-labelledby="recent-writing">
    <div class="section-heading">
      <div>
        <h2 id="recent-writing">Recent writing</h2>
        <p class="section-caption">
          Notes on people, technology, and everything in between.
        </p>
      </div>
      <a class="text-link" href="/writing">
        All writing <Icon />
      </a>
    </div>
    {postsResult.entries.length ? (
      <div>
        {postsResult.entries.map((post, index) => (
          <PostCard post={post} index={index} />
        ))}
      </div>
    ) : (
      <EmptyState
        title="A fresh page."
        text="There are new ideas taking shape. Follow the RSS feed to catch the first articles when they’re ready."
      />
    )}
  </section>
  <section class="note-band">
    <div>
      <p class="eyebrow">The person behind the pixels</p>
      <h2 style="margin-top:14px">People. Software. Possibility.</h2>
      <p>
        I care about the people behind good software, and the curiosity that
        keeps us building.
      </p>
      <a class="text-link" href="/about">
        More about me <Icon />
      </a>
    </div>
    <div>
      <p class="eyebrow">Stay in the loop</p>
      <h2 style="margin-top:14px">A quieter way to follow along.</h2>
      <p>
        No algorithm, no inbox clutter. New articles, delivered to your favorite
        feed reader.
      </p>
      <a class="text-link" href="/feed.xml">
        Subscribe via RSS <Icon name="rss" />
      </a>
    </div>
  </section>
</Base>
