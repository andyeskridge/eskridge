{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "fetchChangeLogs": "pr",
  "lockFileMaintenance": {
    "enabled": true,
    "recreateWhen": "always",
    "rebaseWhen": "behind-base-branch",
    "branchTopic": "lock-file-maintenance",
    "commitMessageAction": "Lock file maintenance",
    "schedule": ["before 5am on monday"],
    "prBodyDefinitions": {
      "Change": "All locks refreshed"
    }
  },
  "prHourlyLimit": 0,
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "groupName": "EmDash CMS",
      "matchPackageNames": ["emdash", "@emdash-cms/**"],
      "automerge": false
    },
    {
      "description": "Node engines declare the supported minimum, not a single pinned runtime.",
      "matchPackageNames": ["node"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "Astro diagnostics still require the TypeScript 6 programmatic API. Revisit when Astro supports TypeScript 7.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
