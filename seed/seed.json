    "projects": [
      {
        "id": "homelab",
        "slug": "a-more-maintainable-homelab",
        "status": "draft",
        "data": {
          "title": "A more maintainable homelab",
          "summary": "Practical lessons from working with TrueNAS, HexOS, Home Assistant, and OpenClaw.",
          "kind": "personal",
          "role": "Owner and builder",
          "year": "2026",
          "context": [
            {
              "_type": "block",
              "_key": "context",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "contexts",
                  "marks": [],
                  "text": "A homelab is a place to try things, but it is also infrastructure you have to live with. My work with TrueNAS and HexOS has become an exercise in making experiments easier to operate and recover."
                }
              ]
            }
          ],
          "approach": [
            {
              "_type": "block",
              "_key": "approach",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "approachs",
                  "marks": [],
                  "text": "Start by inspecting the real system. Preserve the complete configuration and create a recovery point before a change. Afterward, verify both service health and the ways I actually use it."
                }
              ]
            },
            {
              "_type": "block",
              "_key": "history",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "historys",
                  "marks": [],
                  "text": "Recent work included recovering OpenClaw state during an upgrade, checking local access separately from remote access, and investigating a certificate-trust problem in Home Assistant."
                }
              ]
            }
          ],
          "outcomes": [
            {
              "_type": "block",
              "_key": "outcomes",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "outcomess",
                  "marks": [],
                  "text": "The lesson I keep coming back to: a change is only finished when it is verified and the next recovery is easier. Durable configuration, explicit health checks, and useful runbooks matter as much as getting a service started."
                }
              ]
            }
          ]
        },
        "taxonomies": {
          "topic": ["technology"]
        }
      }
    ],
