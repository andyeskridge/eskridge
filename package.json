{
  "name": "eskridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.23.4"
  },
  "emdash": {
    "label": "Andy Eskridge",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "wrangler dev --persist-to .wrangler/state",
    "typecheck": "astro check",
    "lint": "biome check .",
    "lint:ci": "biome ci . && prettier --check 'src/**/*.astro'",
    "format": "prettier --write 'src/**/*.astro' && biome check --write .",
    "test": "bun test tests",
    "e2e": "playwright test",
    "cf-typegen": "wrangler types",
    "seed:validate": "bun scripts/validate-seed.ts",
    "configure:cms": "bun scripts/configure-cms.ts",
    "deploy:staging": "bun scripts/deploy.ts staging",
    "deploy:production": "bun scripts/deploy.ts production",
    "backup": "bun scripts/backup.ts",
    "test:runtime": "node scripts/test-comment-runtime.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.7",
    "@astrojs/react": "7.1.8",
    "@emdash-cms/cloudflare": "1.4.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "astro": "7.4.11",
    "emdash": "1.4.0",
    "picomatch": "4.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@aws-sdk/client-s3": "3.1167.0",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.7",
    "@cloudflare/workers-types": "5.20261110.1",
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20261101.0-beta",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "wrangler": "4.160.1"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "sharp",
    "workerd"
  ],
  "overrides": {
    "@cloudflare/vite-plugin": "1.69.1",
    "baseline-browser-mapping": "2.11.37",
    "body-parser": "2.4.0",
    "browserslist": "4.29.5",
    "dompurify": "3.4.17",
    "js-yaml": "4.3.2",
    "miniflare": "5.20261101.0-beta",
    "qs": "6.17.1",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "undici@7": "7.30.1",
    "zod": "4.6.7"
  },
  "patchedDependencies": {
    "emdash@1.4.0": "patches/emdash@1.4.0.patch"
  }
}
