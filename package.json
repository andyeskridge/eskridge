{
  "name": "eskridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.19"
  },
  "emdash": {
    "label": "Andy Eskridge",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "wrangler dev --persist-to .wrangler/state",
    "typecheck": "astro check",
    "lint": "biome check .",
    "lint:ci": "biome ci . && prettier --check 'src/**/*.astro'",
    "format": "prettier --write 'src/**/*.astro' && biome check --write .",
    "test": "bun test tests",
    "e2e": "playwright test",
    "cf-typegen": "wrangler types",
    "seed:validate": "bun scripts/validate-seed.ts",
    "configure:cms": "bun scripts/configure-cms.ts",
    "deploy:staging": "bun scripts/deploy.ts staging",
    "deploy:production": "bun scripts/deploy.ts production",
    "backup": "bun scripts/backup.ts",
    "test:runtime": "node scripts/test-comment-runtime.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "7.0.1",
    "@emdash-cms/cloudflare": "1.1.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "astro": "7.3.6",
    "emdash": "1.1.0",
    "picomatch": "4.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@aws-sdk/client-s3": "3.1147.0",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261006.1",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20260926.1-alpha",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "wrangler": "4.148.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "sharp",
    "workerd"
  ],
  "overrides": {
    "baseline-browser-mapping": "2.11.27",
    "browserslist": "4.29.3",
    "dompurify": "3.4.16",
    "js-yaml": "4.3.2",
    "miniflare": "5.20260926.1-alpha",
    "qs": "6.16.0",
    "sharp": "0.35.5"
  },
  "patchedDependencies": {
    "emdash@1.1.0": "patches/emdash@1.1.0.patch"
  }
}
