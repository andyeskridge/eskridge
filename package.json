{
  "name": "eskridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "v26.10.0"
  },
  "emdash": {
    "label": "Andy Eskridge",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "wrangler dev --persist-to .wrangler/state",
    "typecheck": "astro check",
    "lint": "biome check .",
    "lint:ci": "biome ci . && prettier --check 'src/**/*.astro'",
    "format": "prettier --write 'src/**/*.astro' && biome check --write .",
    "test": "bun test tests",
    "e2e": "playwright test",
    "cf-typegen": "wrangler types",
    "seed:validate": "bun scripts/validate-seed.ts",
    "deploy:staging": "bun scripts/deploy.ts staging",
    "deploy:production": "bun scripts/deploy.ts production",
    "backup": "bun scripts/backup.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/react": "6.0.5",
    "@emdash-cms/cloudflare": "1.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "astro": "7.3.2",
    "emdash": "1.0.1",
    "picomatch": "4.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@aws-sdk/client-s3": "3.1143.0",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@cloudflare/workers-types": "5.20260820.1",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "wrangler": "4.143.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "sharp",
    "workerd"
  ],
  "patchedDependencies": {
    "emdash@1.0.1": "patches/emdash@1.0.1.patch"
  }
}
